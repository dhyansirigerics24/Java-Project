PRINT "=== Primitive Types ===";
int x = 10;
float f = 2.5;
string s = "Hello";
boolean b = true;
PRINT x;
PRINT f;
PRINT s;
PRINT b;

PRINT "=== Math Operations ===";
ADD x 5;
PRINT x; 
// 3-operand ADD
ADD x x, f;
PRINT x;
DIV f 2;
PRINT f;
/* String concatenation */ 
ADD s " World";
PRINT s; 

PRINT "=== Control Flow ===";
IF x > 10
    PRINT "x is greater than 10";
ELSE
    PRINT "x is small";
ENDIF

int count = 2;
WHILE count > 0
   PRINT count;
   ADD count -1;
ENDWHILE

PRINT "=== Classes and Objects ===";
CLASS Person
    string name;
    int age;
ENDCLASS

Person p = NEW Person;
SET p.name = "Alice";
SET p.age = 25;
PRINT p.name;
PRINT p.age;
PRINT "Done";
